---
import Title from "../ui/Title.astro";
import { t } from "../../i18n";
import StackCard from "../shared/StackCard.astro";

const lang =
  Astro.request.headers.get("cookie")?.match(/preferredLang=([^;]+)/)?.[1] ||
  "es";

const categories = [
  {
    title: "Infraestructura & Contenedores",
    skills: [
      { name: "Docker", icon: "docker" },
      { name: "Kubernetes", icon: "kubernetes" },
      { name: "Git", icon: "git" },
      { name: "Linux", icon: "linux" },
      { name: "Proxmox", icon: "proxmox" },
    ],
  },
  {
    title: "IA, Backend & MLOps",
    skills: [
      { name: "Python", icon: "python" },
      { name: "PyTorch", icon: "pytorch" },
      { name: "Ollama", icon: "ollama" },
      { name: "Pandas", icon: "pandas" },
    ],
  },
  {
    title: "Bases de Datos & Streaming",
    skills: [
      { name: "PostgreSQL", icon: "postgresql" },
      { name: "MongoDB", icon: "mongodb" },
      { name: "MySQL", icon: "mysql" },
      { name: "Apache Kafka", icon: "apachekafka" },
      { name: "Apache Spark", icon: "apachespark" },
    ],
  },
  {
    title: "Frontend & Web",
    skills: [
      { name: "Astro", icon: "astro" },
      { name: "Svelte", icon: "svelte" },
      { name: "Vite", icon: "vite" },
      { name: "Tailwind CSS", icon: "tailwindcss" },
    ],
  },
];
---

<section id="stack" class="py-32 px-6 relative overflow-hidden">
  <!-- Brillo dorado en la esquina -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-[#daa032]/5 blur-[120px] rounded-full -mr-48 -mt-48"></div>

  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col items-center justify-center mb-20 gap-6 text-center">
      <div class="max-w-2xl mx-auto">
        <Title text={t(lang, "pages.stack.title")} class="text-center !mb-4" />
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-stretch">
      {categories.map((category) => (
        <StackCard
          categoryTitle={category.title}
          skills={category.skills}
          class="stack-card opacity-0 translate-y-10"
        />
      ))}
    </div>
  </div>
</section>

<script>
  function setupStackAnimation() {
    const cards = document.querySelectorAll(".stack-card");

    if (cards.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            el.style.opacity = "1";
            el.style.transform = "translateY(0)";
            el.style.transition = "all 0.8s cubic-bezier(0.2, 1, 0.3, 1)";
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.1 }
    );

    cards.forEach((card) => observer.observe(card));
  }

  document.addEventListener("DOMContentLoaded", setupStackAnimation);
  document.addEventListener("astro:page-load", setupStackAnimation);
</script>